# Non-secret process settings only. Configure the Ark secret in the UI;
# it is stored in the operating-system keychain, never in this file.
VLM_HOST=127.0.0.1
VLM_PORT=8000

# Defaults to ~/.vlm-inspector. Uncomment and use an absolute path to override.
# VLM_DATA_DIR=/absolute/path/to/vlm-inspector-data

# Feishu report destination. Configure these values locally;
# the web UI is intentionally read-only and these values are not secrets.
VLM_LARK_CLI_PATH=lark-cli
VLM_FEISHU_REFERENCE_URL=
VLM_FEISHU_PARENT_TOKEN=
VLM_FEISHU_PARENT_LABEL=
