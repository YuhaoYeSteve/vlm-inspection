# Non-secret process settings only. Configure Ark and Feishu secrets in the UI;
# they are stored in the operating-system keychain, never in this file.
VLM_HOST=127.0.0.1
VLM_PORT=8000

# Defaults to ~/.vlm-inspector. Uncomment and use an absolute path to override.
# VLM_DATA_DIR=/absolute/path/to/vlm-inspector-data
